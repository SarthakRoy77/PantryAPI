// use prisma-8

enum UserType {
    @@type("pg/text@1")
    ADMIN = "admin"
    USER = "user"
}

model User {
    id Int @id @default(autoincrement())
    name String
    password String
    userType UserType @default(USER)
    dateCreatedAt DateTime @default(now())
}

model FoodItem {
    id Int @id @default(autoincrement())
    name String
    price Int
    calories Int 
    dateAddedAt DateTime @default(now())
}