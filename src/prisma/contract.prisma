// use prisma-8

enum UserType {
    @@type("pg/text@1")
    ADMIN = "admin"
    USER = "user"
}

enum EmployeeType {
    @@type("pg/text@1")
    RECEPTIONIST = "receptionist"
    CHEFS = "chefs"
    MANAGER = "manager"
}

model User {
    id Int @id @default(autoincrement())
    name String
    password String
    userType UserType @default(USER)
    dateCreatedAt DateTime @default(now())
}

model Employee {
    id Int @id @default(autoincrement())
    name String
    password String
    wage Int
    EmployeeType EmployeeType @default(CHEFS)
    dateHiredAt DateTime @default(now())
}

model FoodItem {
    id Int @id @default(autoincrement())
    name String
    price Int
    calories Int 
    dateAddedAt DateTime @default(now())
}